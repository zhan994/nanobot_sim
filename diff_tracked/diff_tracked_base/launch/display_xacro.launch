<launch>

  <param name="robot_description" command="$(find xacro)/xacro $(find diff_tracked_base)/urdf/bunker_laser_3d.xacro" />

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
  <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui" />
  
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find diff_tracked_base)/rviz/display.rviz" />
</launch>
