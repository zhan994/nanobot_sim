<launch>
  <!-- Defaults match the first path pose generated by rectangle_field.yaml. -->
  <arg name="spawn_x" default="27.0"/>
  <arg name="spawn_y" default="16.0"/>
  <arg name="spawn_yaw" default="3.141592653589793"/>
  <arg name="spawn_z" default="0.40"/>

  <include file="$(find diff_tracked_gazebo)/launch/bunker_gazebo.launch">
    <arg name="world_name"
         value="$(find diff_tracked_gazebo)/worlds/rectangle_field.world"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="spawn_yaw" value="$(arg spawn_yaw)"/>
    <arg name="spawn_z" value="$(arg spawn_z)"/>
  </include>
</launch>
