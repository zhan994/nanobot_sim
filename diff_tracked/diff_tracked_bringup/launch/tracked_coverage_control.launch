<launch>
  <arg name="start_gazebo" default="true"/>
  <arg name="start_localization" default="true"/>
  <arg name="start_slam" default="false"/>
  <arg name="start_slam_localization" default="true"/>
  <arg name="start_planning" default="true"/>
  <arg name="start_control" default="true"/>

  <!-- These defaults match rectangle_field.yaml and its first path pose. -->
  <arg name="world_name"
       default="$(find diff_tracked_gazebo)/worlds/rectangle_field.world"/>
  <arg name="spawn_x" default="27.0"/>
  <arg name="spawn_y" default="16.0"/>
  <arg name="spawn_yaw" default="3.141592653589793"/>

  <arg name="posegraph_file"
       default="/home/democles/diff_drive/posegraphs/rectangle_field_posegraph"/>
  <arg name="localization_initial_x" default="$(arg spawn_x)"/>
  <arg name="localization_initial_y" default="$(arg spawn_y)"/>
  <arg name="localization_initial_yaw" default="$(arg spawn_yaw)"/>

  <arg name="planning_config"
       default="$(find diff_tracked_planning)/config/rectangle_field.yaml"/>
  <arg name="path_topic" default="/coverage_path"/>
  <arg name="speed" default="2"/>
  <arg name="control_startup_delay" default="5.0"/>
  <arg name="odom_topic" default="/odom"/>

  <arg name="localization_pose_timeout" default="15.0"/>
  <arg name="origin_position_tolerance" default="0.30"/>
  <arg name="origin_yaw_tolerance" default="0.35"/>
  <arg name="localization_stable_duration" default="1.0"/>

  <include if="$(arg start_gazebo)"
           file="$(find diff_tracked_gazebo)/launch/bunker_gazebo.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="spawn_yaw" value="$(arg spawn_yaw)"/>
  </include>

  <include if="$(arg start_localization)"
           file="$(find diff_tracked_localization)/launch/ekf_odom.launch">
    <arg name="odom_input" value="/encoder_odom"/>
    <arg name="imu_input" value="/imu"/>
    <arg name="odom_output" value="$(arg odom_topic)"/>
    <arg name="base_frame" value="base_link"/>
    <arg name="publish_tf" value="true"/>
    <arg name="initial_x" value="$(arg spawn_x)"/>
    <arg name="initial_y" value="$(arg spawn_y)"/>
    <arg name="initial_yaw" value="$(arg spawn_yaw)"/>
  </include>

  <!-- Only one node may publish map -> odom. -->
  <include if="$(eval arg('start_slam') and not arg('start_slam_localization'))"
           file="$(find slam_toolbox)/launch/online_async.launch"/>

  <include if="$(arg start_slam_localization)"
           file="$(find diff_tracked_bringup)/launch/slam_toolbox_localization.launch">
    <arg name="posegraph_file" value="$(arg posegraph_file)"/>
    <arg name="initial_pose_x" value="$(arg localization_initial_x)"/>
    <arg name="initial_pose_y" value="$(arg localization_initial_y)"/>
    <arg name="initial_pose_yaw" value="$(arg localization_initial_yaw)"/>
  </include>

  <include if="$(arg start_planning)"
           file="$(find diff_tracked_planning)/launch/coverage_planner.launch">
    <arg name="config" value="$(arg planning_config)"/>
    <arg name="frame_id"
         value="$(eval 'map' if arg('start_slam') or arg('start_slam_localization') else 'odom')"/>
    <arg name="path_topic" value="$(arg path_topic)"/>
  </include>

  <include if="$(arg start_control)"
           file="$(find diff_tracked_control)/launch/path_rpp_control.launch">
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="path_topic" value="$(arg path_topic)"/>
    <arg name="map_frame"
         value="$(eval 'map' if arg('start_slam') or arg('start_slam_localization') else 'odom')"/>
    <arg name="speed" value="$(arg speed)"/>
    <arg name="startup_delay" value="$(arg control_startup_delay)"/>
    <arg name="require_origin_confirmation"
         value="$(arg start_slam_localization)"/>
    <arg name="origin_pose_x" value="$(arg localization_initial_x)"/>
    <arg name="origin_pose_y" value="$(arg localization_initial_y)"/>
    <arg name="origin_pose_yaw" value="$(arg localization_initial_yaw)"/>
    <arg name="localization_pose_timeout"
         value="$(arg localization_pose_timeout)"/>
    <arg name="scan_topic" value="/scan_2d"/>
    <arg name="origin_position_tolerance"
         value="$(arg origin_position_tolerance)"/>
    <arg name="origin_yaw_tolerance" value="$(arg origin_yaw_tolerance)"/>
    <arg name="localization_stable_duration"
         value="$(arg localization_stable_duration)"/>
  </include>
</launch>
