<?xml version="1.0"?>
<model>
  <name>airylike_lidar</name>
  <version>1.0</version>
  <sdf version="1.6">airylike_lidar.sdf</sdf>

  <author>
   <name>Codex</name>
  </author>

  <description>
    搭载 Airy-like 雷达的 3DR Iris 无人机模型，使用 Velodyne Gazebo ROS
    点云插件。水平视场 360°、900 个采样点（约 0.4° 分辨率），垂直视场
    90°、96 线，扫描频率 10 Hz；测距范围 0.1～60 m，距离分辨率 0.002 m，
    每帧共 86400 条射线。点云话题为 /velodyne_points，坐标系为 velodyne，
    高斯噪声标准差为 0.012 m，最低强度为 0。
  </description>
</model>
