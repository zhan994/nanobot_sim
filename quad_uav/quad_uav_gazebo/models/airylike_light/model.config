<?xml version="1.0"?>
<model>
  <name>airylike_light</name>
  <version>1.0</version>
  <sdf version="1.6">airylike_light.sdf</sdf>

  <author>
    <name>Codex</name>
  </author>

  <description>
    搭载轻量版 Airy-like 雷达的 3DR Iris 无人机模型，使用 Velodyne Gazebo
    ROS 点云插件。水平视场 360°、180 个采样点（约 2° 分辨率），垂直视场
    90°、96 线，扫描频率 10 Hz；测距范围 0.1～30 m，距离分辨率 0.002 m，
    每帧共 17280 条射线。点云话题为 /velodyne_points，坐标系为 velodyne，
    高斯噪声标准差为 0.012 m，最低强度为 0。
  </description>
</model>
