<?xml version="1.0"?>
<launch>
  <!--
    Transform the Airy-like lidar cloud to world coordinates and model the
    intermittent returns of the three 35 mm power lines in uav_complex_120m.
    Other worlds should continue to run pointcloud_to_body.py directly.
  -->
  <arg name="input_topic" default="/velodyne_points"/>
  <arg name="output_topic" default="/velodyne_points_world"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <arg name="random_seed" default="120"/>

  <node pkg="quad_uav_gazebo"
        type="pointcloud_to_body.py"
        name="pointcloud_to_body"
        output="screen">
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="output_topic" value="$(arg output_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="target_frame" value="world"/>
    <param name="body_filter_radius" value="1.0"/>

    <param name="wire_dropout_enabled" value="true"/>
    <rosparam param="wire_lines">
      [[-18.1, 9.35], [-16.0, 9.2], [-13.9, 9.35]]
    </rosparam>
    <param name="wire_x_min" value="-52.0"/>
    <param name="wire_x_max" value="54.0"/>
    <param name="wire_detection_radius" value="0.10"/>
    <param name="wire_segment_length" value="0.5"/>

    <!-- Detection falls with range and with near-parallel viewing angle. -->
    <param name="wire_near_detection_probability" value="0.72"/>
    <param name="wire_range_decay" value="38.0"/>
    <param name="wire_angle_floor" value="0.15"/>

    <!-- Segments persist between scans, producing stable broken patches. -->
    <param name="wire_temporal_persistence" value="0.90"/>
    <param name="wire_segment_on_probability" value="0.65"/>
    <param name="wire_hidden_probability_scale" value="0.12"/>
    <param name="wire_random_seed" value="$(arg random_seed)"/>

    <!-- Do not classify the visible pole tops as wire points. -->
    <rosparam param="wire_pole_x">
      [-52.0, -34.0, -16.0, 2.0, 20.0, 38.0, 54.0]
    </rosparam>
    <param name="wire_pole_exclusion_half_width" value="0.35"/>
  </node>
</launch>
