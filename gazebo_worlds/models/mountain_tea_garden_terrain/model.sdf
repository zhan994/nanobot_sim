<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mountain_tea_garden_terrain">
    <static>true</static>
    <link name="terrain_link">
      <collision name="terrain_collision">
        <geometry>
          <heightmap>
            <uri>model://mountain_tea_garden_terrain/materials/textures/tea_garden_heightmap.png</uri>
            <size>80 80 17</size>
            <pos>0 0 0.5</pos>
          </heightmap>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.15</mu>
              <mu2>1.15</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="terrain_visual">
        <cast_shadows>true</cast_shadows>
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://mountain_tea_garden_terrain/materials/textures/tea_soil_diffuse.png</diffuse>
              <normal>model://mountain_tea_garden_terrain/materials/textures/flat_normal.png</normal>
              <size>7</size>
            </texture>
            <uri>model://mountain_tea_garden_terrain/materials/textures/tea_garden_heightmap.png</uri>
            <size>80 80 17</size>
            <pos>0 0 0.5</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
